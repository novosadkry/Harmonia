{
  "name": "harmonia",
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "npm -w @harmonia/db run db:generate",
    "db:migrate": "npm -w @harmonia/db run db:migrate"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.1",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "packageManager": "npm@9.8.1",
  "allowScripts": {
    "@discordjs/opus@0.10.0": true,
    "@prisma/engines@7.8.0": true,
    "esbuild@0.28.0": true,
    "ffmpeg-static@5.3.0": true,
    "prisma@7.8.0": true,
    "sharp@0.34.5": true
  }
}
